
i.${DOMAIN} {
  forward . 10.13.2.100
  errors
  log
}

${DOMAIN} {
  # Split horizon: keep LAN traffic for the public hosts inside the network
  # instead of hairpinning out through the router. This used to point at the
  # external proxy (10.13.2.20); that host is retired, so it now points at the
  # nginx-external Gateway's MetalLB address.
  #
  # All nine public hosts are pinned, not just the four the proxy era listed.
  # docsrv/unifi/blog/tphc/studi-conf previously fell through to public DNS and
  # relied on the router's NAT loopback; pinning them removes that dependency.
  # These are also the names in-cluster back-channel calls use now that the
  # *.k3s.i.${DOMAIN} listeners are gone (Grafana and oauth2-proxy both reach
  # Authelia over https://auth.${DOMAIN}).
  hosts {
    10.13.2.35  cloud.${DOMAIN}
    10.13.2.35  grafana.${DOMAIN}
    10.13.2.35  auth.${DOMAIN}
    10.13.2.35  stream.${DOMAIN}
    10.13.2.35  docsrv.${DOMAIN}
    10.13.2.35  unifi.${DOMAIN}
    10.13.2.35  blog.${DOMAIN}
    10.13.2.35  tphc.${DOMAIN}
    10.13.2.35  studi-conf.${DOMAIN}
    reload 1s
    fallthrough   # unknown ${DOMAIN} hosts fall through to forward below
  }
  # Return NXDOMAIN for AAAA queries on the pinned hosts so dual-stack clients
  # don't attempt to reach them over IPv6. Must list the same hosts as above,
  # otherwise the added names leak a public AAAA and bypass the split horizon.
  template IN AAAA cloud.${DOMAIN}. grafana.${DOMAIN}. auth.${DOMAIN}. stream.${DOMAIN}. docsrv.${DOMAIN}. unifi.${DOMAIN}. blog.${DOMAIN}. tphc.${DOMAIN}. studi-conf.${DOMAIN}. {
    rcode NXDOMAIN
  }
  forward . 10.13.2.100
  cache 300
  errors
  log
}

# ── Block 3 (catch-all): everything else, including blocklist ─────────────
. {
  reload
  health
  header {
    response set ra # set RecursionAvailable flag
  }

  # Blocklist sinkhole loaded from the file built by the init container.
  # Behaviour per query type for a BLOCKED host:
  #   A    → 0.0.0.0  (sinkhole)
  #   AAAA → NODATA   (name known, no AAAA record; does not fall through
  #                    to forward, so the real AAAA is never leaked)
  # Behaviour for an UNBLOCKED host:
  #   any  → fallthrough → forward
  hosts /etc/blocklist {
    no_reverse    # suppress PTR synthesis for 0.0.0.0
    reload 5m
    fallthrough
  }

  forward . 1.1.1.1
  log
  loop
  errors
  cache 300
}
